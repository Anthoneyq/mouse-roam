{
  "name": "mouse-roam",
  "productName": "Mouse Roam",
  "version": "0.1.0",
  "description": "One keyboard and mouse for multiple local computers: Mac, Windows, Linux and Omarchy. A software KVM with optional capture-card screen switching.",
  "keywords": [
    "software-kvm",
    "kvm-switch",
    "keyboard-mouse-sharing",
    "share-mouse-and-keyboard",
    "synergy-alternative",
    "deskflow-alternative",
    "lan-mouse",
    "capture-card",
    "omarchy",
    "hyprland",
    "macos",
    "windows",
    "linux"
  ],
  "homepage": "https://github.com/Anthoneyq/mouse-roam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anthoneyq/mouse-roam.git"
  },
  "author": "Anthoney",
  "license": "GPL-3.0-or-later",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "electron . --preview",
    "test": "node --test tests/*.test.cjs",
    "engine": "node scripts/build-engine.mjs",
    "package": "electron-builder --publish never",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "selfsigned": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.55.0",
    "prettier": "^3.9.8"
  },
  "build": {
    "appId": "app.mouseroam.desktop",
    "asar": true,
    "files": [
      "app/**",
      "assets/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/engine",
        "to": "engine"
      },
      {
        "from": "THIRD-PARTY.md",
        "to": "THIRD-PARTY.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "mac": {
      "identity": "-",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Show the other computer through your HDMI capture card.",
        "NSLocalNetworkUsageDescription": "Find and connect to your other computer on your local network."
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "mouse-roam"
    }
  }
}

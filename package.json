{
  "name": "edge-switch",
  "productName": "Edge Switch",
  "version": "0.1.0",
  "description": "Move your mouse to switch computers and screens.",
  "author": "Anthoney",
  "license": "GPL-3.0-or-later",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "electron . --preview",
    "test": "node --test tests/*.test.cjs",
    "engine": "node scripts/build-engine.mjs",
    "package": "electron-builder --publish never",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "selfsigned": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.55.0",
    "prettier": "^3.9.8"
  },
  "build": {
    "appId": "app.edgeswitch.desktop",
    "asar": true,
    "files": [
      "app/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/engine",
        "to": "engine"
      },
      {
        "from": "THIRD-PARTY.md",
        "to": "THIRD-PARTY.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Show the other computer through your HDMI capture card.",
        "NSLocalNetworkUsageDescription": "Find and connect to your other computer on your local network."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "edge-switch"
    }
  }
}
